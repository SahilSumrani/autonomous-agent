# ==============================================================================
# TECHVERSE AI CLIENT ACQUISITION OS V2 — ENVIRONMENT CONFIGURATION
# Local-first development default values
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME="TechVerse AI Client Acquisition OS"
API_V1_STR="/api/v1"
SECRET_KEY=change_this_to_a_secure_random_string_in_production_32chars_min

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=techverse_os
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/techverse_os

# Redis (v7+)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (Default: local-first via Ollama)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Optional Cloud AI Providers (Fallbacks)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional Enrichment / Search Providers (Default: none / local)
SEARCH_PROVIDER=local
ENRICHMENT_PROVIDER=none
HUNTER_API_KEY=

# Outreach Mode (Default: manual draft queue with human approval)
OUTREACH_PROVIDER=manual
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=outreach@techverse.ai

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SSRF_PROTECTION_ENABLED=true
